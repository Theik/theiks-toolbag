      "packs": [
        "demo-scenes"
      ]
    }
  ],
  "url": "https://github.com/Theik/theiks-toolbag",
  "manifest": "https://github.com/Theik/theiks-toolbag/releases/latest/download/module.json",
  "download": "https://github.com/Theik/theiks-toolbag/releases/download/v0.1.0/theiks-toolbag.zip",
  "bugs": "https://github.com/Theik/theiks-toolbag/issues",
  "readme": "https://github.com/Theik/theiks-toolbag/blob/main/README.md"
