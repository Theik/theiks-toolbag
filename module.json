  "description": "A collection of helpful tools for Foundry Virtual Tabletop.",
  "version": "0.1.0",
  "authors": [
    {
      "name": "Theik",
      "url": "https://github.com/Theik"
    }
  ],
  "compatibility": {
    "minimum": "14",
    "verified": "14",
    "maximum": "14"
  },
  "socket": true,
  "esmodules": [
    "scripts/theiks-toolbag.js"
  ],
  "styles": [
    "styles/theiks-toolbag.css"
  ],
