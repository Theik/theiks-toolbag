<fieldset class="theiks-toolbag footprints" data-kind="{{kind}}">
    <legend>{{localize "THEIKS_TOOLBAG.Footprints.Config.Legend"}}</legend>
    {{#if isScene}}
    <div class="form-group">
        <label for="{{rootId}}-enabled">{{localize "THEIKS_TOOLBAG.Footprints.Config.Enabled"}}</label>
        <div class="form-fields"><input id="{{rootId}}-enabled" type="checkbox" name="{{fields.enabled}}" data-dtype="Boolean" {{checked enabled}}></div>
    </div>
    {{/if}}
    {{#if isLevel}}
    <div class="form-group">
        <label for="{{rootId}}-enabled">{{localize "THEIKS_TOOLBAG.Footprints.Config.Enabled"}}</label>
        <div class="form-fields">
            <select id="{{rootId}}-enabled" name="{{fields.enabled}}">
                <option value="inherit" {{#if (eq levelEnabled "inherit")}}selected{{/if}}>{{localize "THEIKS_TOOLBAG.Footprints.Config.Inherit"}}</option>
                <option value="true" {{#if (eq levelEnabled "true")}}selected{{/if}}>{{localize "THEIKS_TOOLBAG.Footprints.Config.On"}}</option>
                <option value="false" {{#if (eq levelEnabled "false")}}selected{{/if}}>{{localize "THEIKS_TOOLBAG.Footprints.Config.Off"}}</option>
            </select>
        </div>
    </div>
    {{/if}}
    {{#if isToken}}
    <div class="form-group">
        <label for="{{rootId}}-none">{{localize "THEIKS_TOOLBAG.Footprints.Config.NoFootprints"}}</label>
        <div class="form-fields"><input id="{{rootId}}-none" type="checkbox" name="{{fields.noFootprints}}" data-dtype="Boolean" {{checked noFootprints}}></div>
    </div>
    <div class="form-group">
        <label for="{{rootId}}-movement-type">{{localize "THEIKS_TOOLBAG.Footprints.Config.MovementType"}}</label>
        <div class="form-fields">
            <select id="{{rootId}}-movement-type" data-movement-type name="{{fields.movementType}}">
                <option value="bipedal" {{#if (eq movementType "bipedal")}}selected{{/if}}>{{localize "THEIKS_TOOLBAG.Footprints.Config.Bipedal"}}</option>
                <option value="quadruped" {{#if (eq movementType "quadruped")}}selected{{/if}}>{{localize "THEIKS_TOOLBAG.Footprints.Config.QuadrupedHop"}}</option>
                <option value="quadrupedAlternating" {{#if (eq movementType "quadrupedAlternating")}}selected{{/if}}>{{localize "THEIKS_TOOLBAG.Footprints.Config.QuadrupedAlternating"}}</option>
                <option value="slither" {{#if (eq movementType "slither")}}selected{{/if}}>{{localize "THEIKS_TOOLBAG.Footprints.Config.Slither"}}</option>
            </select>
        </div>
    </div>
    {{/if}}
    <div class="form-group">
        <label for="{{rootId}}-image">{{localize "THEIKS_TOOLBAG.Footprints.Config.Image"}}</label>
        <div class="form-fields"><file-picker id="{{rootId}}-image" name="{{fields.image}}" type="image" value="{{image}}"></file-picker></div>
        <p class="hint">{{localize "THEIKS_TOOLBAG.Footprints.Config.ImageHint"}}</p>
    </div>
    {{#if isToken}}
    <div class="form-group" data-gait-field="feet">
        <label for="{{rootId}}-alternate-side">{{localize "THEIKS_TOOLBAG.Footprints.Config.AlternateSide"}}</label>
        <div class="form-fields">
            <select id="{{rootId}}-alternate-side" data-alternate-side name="{{fields.alternateSide}}">
                <option value="none" {{#if (eq alternateSide "none")}}selected{{/if}}>{{localize "THEIKS_TOOLBAG.Footprints.Config.NoAlternate"}}</option>
                <option value="left" {{#if (eq alternateSide "left")}}selected{{/if}}>{{localize "THEIKS_TOOLBAG.Footprints.Config.Left"}}</option>
                <option value="right" {{#if (eq alternateSide "right")}}selected{{/if}}>{{localize "THEIKS_TOOLBAG.Footprints.Config.Right"}}</option>
            </select>
        </div>
        <p class="hint">{{localize "THEIKS_TOOLBAG.Footprints.Config.AlternateHint"}}</p>
    </div>
    <div class="form-group" data-gait-field="alternate-image">
        <label for="{{rootId}}-alternate-image">{{localize "THEIKS_TOOLBAG.Footprints.Config.AlternateImage"}}</label>
        <div class="form-fields"><file-picker id="{{rootId}}-alternate-image" name="{{fields.alternateImage}}" type="image" value="{{alternateImage}}"></file-picker></div>
    </div>
    <div class="form-group" data-gait-field="quadruped">
        <label for="{{rootId}}-front-image">{{localize "THEIKS_TOOLBAG.Footprints.Config.FrontImage"}}</label>
        <div class="form-fields"><file-picker id="{{rootId}}-front-image" name="{{fields.frontImage}}" type="image" value="{{frontImage}}"></file-picker></div>
        <p class="hint">{{localize "THEIKS_TOOLBAG.Footprints.Config.FrontImageHint"}}</p>
    </div>
    <div class="form-group" data-gait-field="quadruped">
        <label for="{{rootId}}-front-alternate-side">{{localize "THEIKS_TOOLBAG.Footprints.Config.FrontAlternateSide"}}</label>
        <div class="form-fields">
            <select id="{{rootId}}-front-alternate-side" data-front-alternate-side name="{{fields.frontAlternateSide}}">
                <option value="none" {{#if (eq frontAlternateSide "none")}}selected{{/if}}>{{localize "THEIKS_TOOLBAG.Footprints.Config.NoFrontAlternate"}}</option>
                <option value="left" {{#if (eq frontAlternateSide "left")}}selected{{/if}}>{{localize "THEIKS_TOOLBAG.Footprints.Config.Left"}}</option>
                <option value="right" {{#if (eq frontAlternateSide "right")}}selected{{/if}}>{{localize "THEIKS_TOOLBAG.Footprints.Config.Right"}}</option>
            </select>
        </div>
    </div>
    <div class="form-group" data-gait-field="front-alternate-image">
        <label for="{{rootId}}-front-alternate-image">{{localize "THEIKS_TOOLBAG.Footprints.Config.FrontAlternateImage"}}</label>
        <div class="form-fields"><file-picker id="{{rootId}}-front-alternate-image" name="{{fields.frontAlternateImage}}" type="image" value="{{frontAlternateImage}}"></file-picker></div>
    </div>
    {{/if}}
    {{#unless isToken}}
    {{#if isLevel}}
    <div class="form-group">
        <label for="{{rootId}}-tint-override">{{localize "THEIKS_TOOLBAG.Footprints.Config.OverrideTint"}}</label>
        <div class="form-fields"><input id="{{rootId}}-tint-override" type="checkbox" name="{{fields.tintOverride}}" data-dtype="Boolean" {{checked tintOverride}}></div>
    </div>
    {{/if}}
    <div class="form-group">
        <label for="{{rootId}}-tint">{{localize "THEIKS_TOOLBAG.Footprints.Config.Tint"}}</label>
        <div class="form-fields">
            <input id="{{rootId}}-tint" data-tint-input type="text" name="{{fields.tint}}" value="{{tint}}">
            <input data-tint-picker type="color" value="{{tint}}" aria-label="{{localize "THEIKS_TOOLBAG.Footprints.Config.Tint"}}">
        </div>
    </div>
    {{/unless}}
    {{#if canClear}}
    <div class="form-group"><button type="button" data-action="clear-footprints"><i class="fa-solid fa-eraser"></i> {{localize "THEIKS_TOOLBAG.Footprints.Config.Clear"}}</button></div>
    {{/if}}
</fieldset>
